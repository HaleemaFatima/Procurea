}}","rightValue":"readDriveQuotation","operator":{"type":"string","operation":"equals"}}]},"renameOutput":true,"outputKey":"Drive"}]},"options":{}},"id":"93b83850-0fbe-4ab6-82dd-a58dc7329a21","name":"Route MCP Read Operation","type":"n8n-nodes-base.switch","typeVersion":3.2,"position":[624,928]},{"parameters":{"operation":"get","messageId":"={{ $json.messageId }}","simple":false,"options":{"dataPropertyAttachmentsPrefixName":"attachment_","downloadAttachments":true}},"id":"ff7d22a2-dd02-4998-84fe-e9fcb7ec9c63","name":"Get Gmail Message + Attachments","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[864,848]},{"parameters":{"jsCode":"const out = [];\n\nfor (const item of items) {\n  const binaries = item.binary || {};\n\n  for (const [key, file] of Object.entries(binaries)) {\n    const fileName = file.fileName || key;\n    const mimeType = file.mimeType || '';\n\n    // Procurea quotations are expected as PDFs in this MCP retrofit.\n    if (mimeType === 'application/pdf' || fileName.toLowerCase().endsWith('.pdf')) {\n      out.push({\n        json: {\n          source: 'gmail',\n          messageId: item.json.id || '',\n          fileName\n        },\n        binary: {\n          data: file\n        }\n      });\n    }\n  }\n}\n\nif (out.length === 0) {\n  throw new Error('No PDF quotation attachment found in this Gmail message.');\n}\n\nreturn out;"},"id":"ab448103-c9ae-43c7-80e1-b2b4077ab38e","name":"Select PDF Quote Attachments","type":"n8n-nodes-base.code","typeVersion":2,"position":[1088,848]},{"parameters":{"operation":"pdf","options":{}},"id":"689b0630-1d2b-4722-869b-40296e7c919f","name":"Extract Gmail Quote PDF","type":"n8n-nodes-base.extractFromFile","typeVersion":1,"position":[1312,848]},{"parameters":{"assignments":{"assignments":[{"id":"5fbd42d2-66c8-461a-bb7c-c73baec4909e","name":"response","value":"={{ JSON.stringify({ source: 'gmail', messageId: $('When Called as MCP Tool').item.json.messageId, text: $json.text }) }}","type":"string"}]},"op