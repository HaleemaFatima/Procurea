# Procurea — example environment variables
PROCUREA_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PROCUREA_SUPABASE_SECRET_KEY=replace_me
GEMINI_API_KEY=replace_me

# Required only when using $env expressions in self-hosted n8n versions
# that block node environment access by default.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
